# The qs security fix in package.json is applied through the "overrides"
# field, which npm only honours from 8.3.0 on. On an older npm the field is
# ignored silently: express and body-parser resolve qs from their own
# "~6.15.1" range, the install completes with no warning, and the two
# advisories the override exists to close are still there.
#
# engine-strict turns the "engines" declaration from a warning into a refusal,
# so an npm that cannot apply the fix stops rather than producing an install
# that only looks patched.
engine-strict=true
